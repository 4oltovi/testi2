APP_NAME=Донишёр
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dushanbe
APP_URL=http://donishor.local

APP_LOCALE=tg
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=daily
LOG_LEVEL=info

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=donishor
DB_USERNAME=donishor_user
DB_PASSWORD=your_secure_password

# Redis (барои кеш, сессия, навбат)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Кеш
CACHE_STORE=redis
CACHE_PREFIX=donishor_

# Сессия
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Навбат (Queue)
QUEUE_CONNECTION=redis

# Файлҳо
FILESYSTEM_DISK=public

# Email (агар лозим бошад)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@donishor.tj"
MAIL_FROM_NAME="Донишёр"

# Пагинатсия
PAGINATION_PER_PAGE=25

# Имтиҳон
EXAM_MAX_DURATION_MINUTES=120
EXAM_AUTO_SAVE_INTERVAL=30

# Баҳогузорӣ
GRADE_FORMULA_TYPE=with_independent_work
ATTENDANCE_MIN_PERCENTAGE=75
MAX_RETAKE_ATTEMPTS=2
